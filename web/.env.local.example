# Copy this file to .env.local (already gitignored) and fill in real values.
# Without these two set, form submissions are still accepted and logged to
# .submissions/submissions.log, but no email is sent — useful for testing
# the form UX before real credentials exist.

# The Gmail account sending on behalf of the site.
GMAIL_USER=wepresentproject@gmail.com

# Generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account first).
GMAIL_APP_PASSWORD=

# Where submission notifications are sent. Defaults to GMAIL_USER's inbox
# (wepresentproject@gmail.com) if not set.
NOTIFY_EMAIL=wepresentproject@gmail.com


# ---------------------------------------------------------------------------
# Content portal login (WO-63)
# ---------------------------------------------------------------------------
# Without all three of these, /admin still loads but signing in returns a plain
# "not configured" message naming the variables that are missing.
#
# Create the OAuth App under the COATI GitHub organisation (Settings ->
# Developer settings -> OAuth Apps -> New OAuth App):
#
#   Homepage URL:               https://wepresent.org
#   Authorization callback URL: https://wepresent.org/api/callback
#
# Register a SECOND app for local testing with http://localhost:3000/api/callback,
# rather than adding localhost to the production app.
#
# THE SECRET IS A CREDENTIAL. Put it in the host's environment settings, never in
# this repo. If one is ever committed, rotate it in GitHub — deleting the commit
# does not un-expose it.

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The site's own origin, no trailing slash. Decap will only accept the access
# token from a message whose origin matches this exactly, and it is also the
# postMessage target, so a wrong value fails closed rather than leaking a token.
# Must match `base_url` in web/public/admin/config.yml.
SITE_URL=https://wepresent.org
